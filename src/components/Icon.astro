---
import { pixelIcons } from '../lib/pixel-icons';
interface Props { name: keyof typeof pixelIcons; class?: string }
const { name, class: className = '' } = Astro.props;
---
<svg viewBox="0 0 20 20" width="20" height="20" class={`ui-icon ${className}`} aria-hidden="true" focusable="false" shape-rendering="crispEdges" fill="currentColor">
  {pixelIcons[name].map(p => <rect x={p.x} y={p.y} width={p.width} height="1" opacity={p.tone === 2 ? 0.5 : 1} />)}
</svg>
